# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# ----- MAIL CONFIGURATION -----
# Fill these in with YOUR email provider's SMTP details.
#
# Example for Gmail (use a 16-character "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Example for Outlook/Office365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@outlook.com
#   SMTP_PASS=your-password
#
# Example for a custom domain (cPanel/Zoho/Hostinger etc.), ask your host for these:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@yourdomain.com
#   SMTP_PASS=your-mailbox-password

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where connection-request notification emails get sent (your inbox)
TO_EMAIL=

# What shows up as the "From" name on outgoing emails
FROM_NAME=Valiant Ledgers Website
